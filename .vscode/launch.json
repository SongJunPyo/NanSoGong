{
  // 왼쪽 "실행 및 디버그"(Ctrl+Shift+D) 에서 고르고 ▶ (F5)
  // "서버 (Spring Boot, 8080)" 는 디버깅용: 컨테이너 서버를 멈추고 DB · Redis · 목업만 띄운 다음 VS Code 에서 서버를 켠다
  // 디버깅이 필요 없으면 터미널에서 docker compose up -d 만 해도 서버까지 컨테이너로 뜬다
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "서버 (Spring Boot, 8080)",
      "request": "launch",
      "mainClass": "com.nansogong.NansogongApplication",
      "projectName": "nansogong",
      "cwd": "${workspaceFolder}/backend",
      "preLaunchTask": "인프라 켜기 (DB · Redis · 목업)"
    },
    {
      "type": "node-terminal",
      "name": "화면 (Vite, 5173)",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "서버 + 화면 같이 켜기",
      "configurations": ["서버 (Spring Boot, 8080)", "화면 (Vite, 5173)"],
      "stopAll": true
    }
  ]
}
