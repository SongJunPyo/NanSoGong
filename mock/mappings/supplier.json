    {
      "name": "가상 거래처 - Idempotency-Key 없으면 400 (중복 전송 방지 규칙)",
      "priority": 1,
      "request": { "method": "POST", "urlPath": "/supplier/v1/orders", "headers": { "Idempotency-Key": { "absent": true } } },
      "response": { "status": 400, "jsonBody": { "code": "IDEMPOTENCY_KEY_REQUIRED", "message": "Idempotency-Key 헤더가 필요합니다." } }
