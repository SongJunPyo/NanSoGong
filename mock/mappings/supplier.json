      "priority": 1,
      "request": { "method": "POST", "urlPath": "/supplier/v1/orders", "headers": { "X-Mock-Scenario": { "equalTo": "timeout" } } },
      "response": { "status": 202, "fixedDelayMilliseconds": 30000, "jsonBody": { "supplierOrderId": "SO-LATE0001", "status": "ACCEPTED" } }
