      "priority": 1,
      "request": { "method": "POST", "urlPath": "/supplier/v1/orders", "headers": { "X-Mock-Scenario": { "equalTo": "partial" } } },
      "response": { "status": 207, "jsonBody": { "supplierOrderId": "SO-PARTIAL1", "status": "PARTIALLY_ACCEPTED", "accepted": ["A-100"], "rejected": [ { "sku": "A-300", "reason": "OUT_OF_STOCK" } ] } }
