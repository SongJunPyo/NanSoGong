# 📋 이 파일을 복사해서 .env 를 만든다:  cp .env.example .env   (Windows PowerShell: copy .env.example .env)
# .env 는 깃에 올라가지 않는다 (.gitignore). 🚨 진짜 키는 .env 에만 적는다
# docker compose 와 Spring Boot(application.yml) 가 이 값을 함께 읽는다

# 🐘 PostgreSQL (docker compose)
DB_NAME=nansogong
DB_USER=dev
DB_PASSWORD=dev
DB_PORT=5432
# 팀 공용 DB 를 쓰려면 주소를 넣고 앞의 # 을 지운다 (DB_USER · DB_PASSWORD 도 그 DB 값으로). bootRun 과 app 컨테이너가 모두 이 DB 에 붙는다
# 비워 두면 docker compose 의 postgres 컨테이너를 쓴다. 🚨 localhost 를 쓰면 app 컨테이너 안에서는 연결되지 않는다
# DB_URL=jdbc:postgresql://<공용 DB 주소>:<포트>/nansogong

# 🧠 Redis (docker compose)
REDIS_PORT=6379

# 🤖 Claude API: 각자 발급받은 키를 넣고 앞의 # 을 지운다. 주석인 채로 두면 서버는 뜨고 AI 기능만 실패한다
#    (🚨 ANTHROPIC_API_KEY= 처럼 빈 값으로 두지 않는다. 빈 키로 인식되어 서버가 뜨지 않을 수 있다)
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-haiku-5-5

# 🔐 로컬은 비워 둬도 된다 (application.yml 의 로컬 기본값 사용)
# JWT_SECRET=replace-with-a-long-random-secret-key

# 🤖 Python AI 워커 → Spring 내부 API(/internal/**) 토큰. 워커로 내부 API 를 부를 때만 넣는다 (비워 두면 /internal/** 는 401)
#    만들기: openssl rand -base64 48. Spring(app)과 Python 워커(ai-worker)가 같은 이 이름 · 같은 값을 쓴다
# INTERNAL_API_TOKEN=

# 🧠 AI 서비스를 내 PC 에서 돌릴 때만 (docker compose --profile ai --profile ai-worker up -d --build, ai/README.md)
#    🚨 AI_SERVICE_TOKEN 은 위 INTERNAL_API_TOKEN 과 다른 값으로 만든다 (방향별 토큰: 한쪽이 새어도 반대 방향은 지켜진다)
#    AI_DB_PASSWORD 는 영문 · 숫자만 (주소에 그대로 들어간다). 만들기: openssl rand -hex 24
#    워커는 실제 Claude 를 부른다 → 위 ANTHROPIC_API_KEY 도 필요하다 (과금)
# AI_SERVICE_TOKEN=
# AI_DB_PASSWORD=
# AI_DATABASE_URL=postgresql://ai_app:${AI_DB_PASSWORD}@postgres:5432/nansogong
# 워커가 부를 Spring 주소: 비워 두면 app 컨테이너(http://app:8080). VS Code 로 Spring 을 띄울 때만 아래를 쓴다
#    (넣어 둔 채 app 컨테이너로 돌아가도 동작한다. app 컨테이너도 내 PC 의 8080 으로 열려 있다)
# SPRING_BASE_URL=http://host.docker.internal:8080
# LangSmith 추적 (선택): 켜면 LANGSMITH_API_KEY 가 필요하다. 프로젝트는 환경별로 나눈다
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=nansogong-local

# 화면을 프록시·다른 포트로 열 때 실제 브라우저 Origin을 정확히 지정한다 (끝의 / 제외, 여러 개는 쉼표로 구분)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# 🎭 외부 연동 목업 서버 포트 (docker compose 의 mock)
MOCK_PORT=8089

# 🌐 외부 API: 아래를 비워 두면 전부 목업(localhost:8089)으로 간다 → 키 없이 개발 가능
#    진짜 API 를 써 보고 싶을 때만 주석을 풀고 값을 넣는다 (공공데이터포털 인증키는 각자 발급)
# DATA_GO_KR_SERVICE_KEY=
# NTS_BASE_URL=https://api.odcloud.kr/api/nts-businessman/v1
# KMA_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
# KMA_SERVICE_KEY=                         # 원본(Decoding) 인증키. DATA_GO_KR_SERVICE_KEY는 그대로 유지
# KAKAO_BASE_URL=https://dapi.kakao.com     # 실제 날씨 조회는 카카오·기상청 주소를 함께 설정
# KAKAO_REST_API_KEY=                      # REST API 키 (JavaScript 키 아님)
# HOLIDAY_BASE_URL=https://apis.data.go.kr/B090041/openapi/service/SpcdeInfoService
# NAVER_DATALAB_BASE_URL=https://openapi.naver.com/v1/datalab
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# 📱 휴대폰 본인인증: mock 이면 인증번호는 항상 000000
# VERIFICATION_MODE=mock

# 🔒 연동 인증 정보 암호화 키: 로컬은 비워 둬도 된다 (application.yml 의 로컬 기본값)

# 🤖 수요 예측 Jupyter 접속 토큰 (docker compose --profile ml)
# JUPYTER_TOKEN=nansogong

# 📱 SENS SMS 수신 인증: 콘솔에서 서비스·발신번호 등록과 SMS 발송 권한을 준비한 후만 설정한다.
# 실제 값은 .env/Secrets에만 넣는다. 키·인증번호를 채팅·로그·소스에 남기지 않는다.
# VERIFICATION_MODE=real
# SENS_SERVICE_ID=ncp:sms:kr:<project-id>:<service-name>
# SENS_ACCESS_KEY=<NCP access key>
# SENS_SECRET_KEY=<NCP secret key>
# SENS_FROM=<등록된 발신번호, 숫자만>

# 🔐 로컬·dev HTTP는 false / HTTPS는 true. 화면·API가 서로 다른 사이트인 경우만 None + Secure=true.
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAME_SITE=Lax
