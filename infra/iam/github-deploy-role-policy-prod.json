{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadDeployBundle",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::<PROD_ARTIFACT_BUCKET>/*"
    },
    {
      "Sid": "StartAndWatchCodeDeploy",
      "Effect": "Allow",
      "Action": [
        "codedeploy:CreateDeployment",
        "codedeploy:GetDeployment",
        "codedeploy:GetDeploymentConfig",
        "codedeploy:GetApplicationRevision",
        "codedeploy:RegisterApplicationRevision"
      ],
      "Resource": [
        "arn:aws:codedeploy:ap-northeast-2:<ACCOUNT_ID>:application:nansogong-prod",
        "arn:aws:codedeploy:ap-northeast-2:<ACCOUNT_ID>:deploymentgroup:nansogong-prod/nansogong-prod-api",
        "arn:aws:codedeploy:ap-northeast-2:<ACCOUNT_ID>:deploymentconfig:*"
      ]
    },
    {
      "Sid": "UploadProdWeb",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::<PROD_WEB_BUCKET>",
        "arn:aws:s3:::<PROD_WEB_BUCKET>/*"
      ]
    },
    {
      "Sid": "InvalidateProdCloudFront",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::<ACCOUNT_ID>:distribution/<PROD_DISTRIBUTION_ID>"
    }
  ]
}
